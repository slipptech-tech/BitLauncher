import sys
import os
import zipfile
import hashlib
import subprocess
import platform
from pathlib import Path
from datetime import datetime


# ============================================================
# BitLauncher - Fabric Environment Diagnostic
# ============================================================

APP_NAME = "BitLauncher Fabric Diagnostic"
APP_VERSION = "1.0.0"

FABRIC_JAR = "fabric-c-26.1.2v.jar"


# ============================================================
# LOGGER
# ============================================================

def log(level: str, message: str) -> None:
    timestamp = datetime.now().strftime("%H:%M:%S")
    print(f"[{timestamp}] [{level:<7}] {message}")


def success(message: str) -> None:
    log("OK", message)


def info(message: str) -> None:
    log("INFO", message)


def warning(message: str) -> None:
    log("WARNING", message)


def error(message: str) -> None:
    log("ERROR", message)


# ============================================================
# SYSTEM
# ============================================================

def print_header() -> None:

    print()
    print("=" * 60)
    print(f" {APP_NAME}")
    print(f" Version: {APP_VERSION}")
    print("=" * 60)
    print()


def check_system() -> None:

    info("Checking system environment...")

    success(
        f"Operating System: "
        f"{platform.system()} {platform.release()}"
    )

    success(
        f"Architecture: "
        f"{platform.machine()}"
    )

    success(
        f"Python: "
        f"{platform.python_version()}"
    )


# ============================================================
# JAVA
# ============================================================

def check_java() -> bool:

    info("Checking Java runtime...")

    try:

        result = subprocess.run(
            ["java", "-version"],
            capture_output=True,
            text=True,
            timeout=5
        )

        output = result.stderr.strip()

        if not output:
            output = result.stdout.strip()

        if result.returncode == 0:

            success("Java runtime detected")

            lines = output.splitlines()

            if lines:
                info(lines[0])

            return True

        error("Java returned an invalid status")

        return False

    except FileNotFoundError:

        error("Java runtime not found")

        return False

    except subprocess.TimeoutExpired:

        warning("Java version check timed out")

        return False

    except Exception as exception:

        error(
            f"Java check failed: "
            f"{exception}"
        )

        return False


# ============================================================
# FILE CHECK
# ============================================================

def check_fabric_file(
    jar_path: Path
) -> bool:

    info(
        f"Searching for Fabric file: "
        f"{jar_path.name}"
    )

    if not jar_path.exists():

        error(
            "Fabric JAR was not found"
        )

        return False

    if not jar_path.is_file():

        error(
            "Fabric path is not a file"
        )

        return False

    success(
        f"Fabric JAR found: "
        f"{jar_path.resolve()}"
    )

    return True


# ============================================================
# FILE SIZE
# ============================================================

def get_file_size(
    jar_path: Path
) -> int:

    try:

        size = jar_path.stat().st_size

        success(
            f"File size: "
            f"{size:,} bytes"
        )

        return size

    except Exception as exception:

        error(
            f"Unable to read file size: "
            f"{exception}"
        )

        return 0


# ============================================================
# SHA256
# ============================================================

def calculate_sha256(
    jar_path: Path
) -> str | None:

    info("Calculating SHA-256 checksum...")

    try:

        sha256 = hashlib.sha256()

        with open(
            jar_path,
            "rb"
        ) as file:

            while True:

                chunk = file.read(
                    1024 * 1024
                )

                if not chunk:
                    break

                sha256.update(chunk)

        checksum = sha256.hexdigest()

        success(
            "SHA-256 checksum calculated"
        )

        info(
            f"SHA-256: {checksum}"
        )

        return checksum

    except Exception as exception:

        error(
            f"Checksum calculation failed: "
            f"{exception}"
        )

        return None


# ============================================================
# JAR STRUCTURE
# ============================================================

def check_jar_structure(
    jar_path: Path
) -> bool:

    info(
        "Checking JAR archive structure..."
    )

    try:

        with zipfile.ZipFile(
            jar_path,
            "r"
        ) as archive:

            corrupted_file = (
                archive.testzip()
            )

            if corrupted_file:

                error(
                    "Corrupted archive entry: "
                    f"{corrupted_file}"
                )

                return False

            success(
                "JAR archive structure is valid"
            )

            return True

    except zipfile.BadZipFile:

        error(
            "File is not a valid JAR/ZIP archive"
        )

        return False

    except Exception as exception:

        error(
            f"Archive validation failed: "
            f"{exception}"
        )

        return False


# ============================================================
# JAR CONTENT
# ============================================================

def inspect_jar(
    jar_path: Path
) -> int:

    info(
        "Inspecting Fabric archive..."
    )

    try:

        with zipfile.ZipFile(
            jar_path,
            "r"
        ) as archive:

            files = archive.namelist()

            count = len(files)

            success(
                f"Archive entries: {count}"
            )

            directories = 0
            class_files = 0
            json_files = 0

            for file_name in files:

                if file_name.endswith("/"):

                    directories += 1

                elif file_name.endswith(".class"):

                    class_files += 1

                elif file_name.endswith(".json"):

                    json_files += 1

            info(
                f"Directories: "
                f"{directories}"
            )

            info(
                f"Java classes: "
                f"{class_files}"
            )

            info(
                f"JSON files: "
                f"{json_files}"
            )

            return count

    except Exception as exception:

        error(
            f"Archive inspection failed: "
            f"{exception}"
        )

        return 0


# ============================================================
# MANIFEST
# ============================================================

def check_manifest(
    jar_path: Path
) -> bool:

    info(
        "Checking JAR manifest..."
    )

    try:

        with zipfile.ZipFile(
            jar_path,
            "r"
        ) as archive:

            manifest_name = (
                "META-INF/MANIFEST.MF"
            )

            if manifest_name not in archive.namelist():

                warning(
                    "Manifest not found"
                )

                return False

            success(
                "Manifest detected"
            )

            data = archive.read(
                manifest_name
            )

            text = data.decode(
                "utf-8",
                errors="replace"
            )

            lines = text.splitlines()

            for line in lines[:10]:

                print(
                    f"    {line}"
                )

            return True

    except Exception as exception:

        error(
            f"Manifest check failed: "
            f"{exception}"
        )

        return False


# ============================================================
# FABRIC METADATA
# ============================================================

def check_fabric_metadata(
    jar_path: Path
) -> bool:

    info(
        "Searching for Fabric metadata..."
    )

    possible_files = [

        "fabric.mod.json",

        "META-INF/fabric.mod.json"

    ]

    try:

        with zipfile.ZipFile(
            jar_path,
            "r"
        ) as archive:

            files = archive.namelist()

            for metadata_file in possible_files:

                if metadata_file in files:

                    success(
                        f"Fabric metadata found: "
                        f"{metadata_file}"
                    )

                    return True

            warning(
                "Fabric metadata not found"
            )

            return False

    except Exception as exception:

        error(
            f"Fabric metadata check failed: "
            f"{exception}"
        )

        return False


# ============================================================
# DIAGNOSTIC RESULT
# ============================================================

def print_result(
    java_ok: bool,
    file_ok: bool,
    archive_ok: bool,
    manifest_ok: bool
) -> None:

    print()

    print("=" * 60)

    print(
        " DIAGNOSTIC RESULT"
    )

    print("=" * 60)

    print()

    results = [

        ("Java Runtime", java_ok),

        ("Fabric JAR", file_ok),

        ("JAR Structure", archive_ok),

        ("JAR Manifest", manifest_ok)

    ]

    passed = 0

    for name, status in results:

        if status:

            print(
                f"[PASS] {name}"
            )

            passed += 1

        else:

            print(
                f"[FAIL] {name}"
            )

    print()

    print(
        f"Tests passed: "
        f"{passed}/{len(results)}"
    )

    print()

    if passed == len(results):

        success(
            "Fabric diagnostic completed successfully"
        )

    else:

        warning(
            "Fabric diagnostic completed with issues"
        )


# ============================================================
# MAIN
# ============================================================

def main() -> None:

    print_header()

    info(
        "Starting BitLauncher Fabric diagnostic..."
    )

    print()

    check_system()

    print()

    java_ok = check_java()

    print()

    jar_path = Path(
        FABRIC_JAR
    )

    file_ok = check_fabric_file(
        jar_path
    )

    archive_ok = False

    manifest_ok = False

    if file_ok:

        print()

        get_file_size(
            jar_path
        )

        print()

        calculate_sha256(
            jar_path
        )

        print()

        archive_ok = check_jar_structure(
            jar_path
        )

        print()

        inspect_jar(
            jar_path
        )

        print()

        manifest_ok = check_manifest(
            jar_path
        )

        print()

        check_fabric_metadata(
            jar_path
        )

    else:

        warning(
            "Skipping Fabric tests because "
            "the JAR file was not found"
        )

    print_result(

        java_ok,

        file_ok,

        archive_ok,

        manifest_ok

    )

    info(
        "Diagnostic process finished"
    )


if __name__ == "__main__":

    try:

        main()

    except KeyboardInterrupt:

        print()

        warning(
            "Diagnostic interrupted by user"
        )

    except Exception as exception:

        error(
            f"Unexpected error: "
            f"{exception}"
        )
